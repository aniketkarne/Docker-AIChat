# Required: OpenAI API key used by the backend for AI optimization & chat.
# Only the AI-backed endpoints (/optimize, /suggestions, /chat) need it.
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: OpenAI model for /optimize and /chat (default: gpt-6-luna).
# OPENAI_MODEL=gpt-6-luna
